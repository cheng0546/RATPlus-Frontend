# Dependencies and generated output are recreated during the image build.
node_modules
dist
.angular
coverage
# Repository metadata and local-only files do not belong in the build context.
.git
.gitignore
.DS_Store
.env
.env.*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Editor and test artefacts.
.idea
.vscode
*.log
